# ─── GiftMind H5 环境变量 ───────────────────────────────
# 复制为 .env.development / .env.production 后按需修改

# 是否使用本地 Mock（true = 前端独立跑通全流程，无需后端）
VITE_USE_MOCK=true

# 真实后端网关（VITE_USE_MOCK=false 时生效）
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT=20000

# 本地开发的接口代理目标（vite.config.js 的 server.proxy）
VITE_API_PROXY_TARGET=http://localhost:8080

# 静态资源部署路径，OSS/CDN 子目录部署时改这里
VITE_PUBLIC_BASE=./
